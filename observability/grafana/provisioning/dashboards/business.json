{
  "id": null,
  "uid": "business-dashboard",
  "title": "Negocio - Productos y Movimientos de Stock",
  "description": "OJO: usa nombres de métricas asumidos (products_created_total, stock_movements_total, products_total). Ajusta las queries si tu app expone otros nombres.",
  "tags": ["business", "prometheus", "day38"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" },
        "label": "Datasource"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Productos totales",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        { "expr": "products_total", "legendFormat": "productos", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Productos agregados (últimas 24h)",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        { "expr": "increase(products_created_total[24h])", "legendFormat": "agregados", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Movimientos de stock (últimas 24h)",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        { "expr": "increase(stock_movements_total[24h])", "legendFormat": "movimientos", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Ratio entradas/salidas (24h)",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "increase(stock_movements_total{type=\"in\"}[24h]) / increase(stock_movements_total{type=\"out\"}[24h])",
          "legendFormat": "entradas/salidas",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Productos agregados en el tiempo",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "increase(products_created_total[1h])",
          "legendFormat": "productos/hora",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Movimientos de stock por tipo",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum by(type) (rate(stock_movements_total[5m]))",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Movimientos de stock por producto (top 10)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "topk(10, sum by(product) (increase(stock_movements_total[24h])))",
          "legendFormat": "{{product}}",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ]
    }
  ]
}
