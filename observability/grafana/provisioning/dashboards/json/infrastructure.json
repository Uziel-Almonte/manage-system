{
  "id": null,
  "uid": "infra-dashboard",
  "title": "Infraestructura - CPU, Memoria y DB Pool",
  "tags": ["infra", "prometheus", "day38"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" },
        "label": "Datasource"
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": "${DS_PROMETHEUS}",
        "query": "label_values(node_cpu_seconds_total, instance)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "label": "Instancia"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Uso de CPU por instancia (%)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 85 },
              { "color": "red", "value": 95 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\", instance=~\"$instance\"}[5m])) * 100)",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memoria residente de la aplicación",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "process_resident_memory_bytes",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Conexiones activas / máximas",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        { "expr": "db_pool_active_connections", "legendFormat": "Activas", "refId": "A" },
        { "expr": "db_pool_max_connections", "legendFormat": "Máximas", "refId": "B" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Evolución del pool de conexiones",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        { "expr": "db_pool_active_connections", "legendFormat": "Activas", "refId": "A" },
        { "expr": "db_pool_max_connections", "legendFormat": "Máximas", "refId": "B" }
      ]
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Alertas críticas",
        "datasource": "${DS_PROMETHEUS}",
        "enable": true,
        "expr": "ALERTS{team=\"infra\", severity=\"critical\"}",
        "iconColor": "red"
      }
    ]
  }
}
