{
  "id": null,
  "uid": "security-dashboard",
  "title": "Seguridad - Fallos de Autenticación y Tokens",
  "tags": [
    "security",
    "prometheus",
    "day38"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "label": "Datasource"
      }
    ]
  },
  "panels": [
    {
      "id": 7,
      "type": "stat",
      "title": "Logins fallidos en Keycloak (últimos 15m)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "round(sum(increase(loki_process_custom_keycloak_login_failures_total[15m]))) or vector(0)",
          "legendFormat": "logins fallidos",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Logins fallidos por motivo (Keycloak)",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 0
      },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum by(reason) (round(increase(loki_process_custom_keycloak_login_failures_total[5m])))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Top IPs con logins fallidos en Keycloak (10m)",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "topk(10, sum by(source_ip) (round(increase(loki_process_custom_keycloak_login_failures_total[10m]))))",
          "legendFormat": "{{source_ip}}",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Fallos de autenticación en el tiempo",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum(rate(auth_failures_total[5m])) or vector(0)",
          "legendFormat": "fallos/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Tokens inválidos en el tiempo",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "round(increase(invalid_tokens_total[15m]))",
          "legendFormat": "tokens inválidos / 15m",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Top IPs por fallos de autenticación (10m)",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "topk(10, sum by(source_ip) (increase(auth_failures_total[10m])))",
          "legendFormat": "{{source_ip}}",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ]
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Alertas de seguridad",
        "datasource": "${DS_PROMETHEUS}",
        "enable": true,
        "expr": "ALERTS{team=\"security\"}",
        "iconColor": "red"
      }
    ]
  }
}
