{
  "id": null,
  "uid": "security-dashboard",
  "title": "Seguridad - Fallos de Autenticación y Tokens",
  "tags": ["security", "prometheus", "day38"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" },
        "label": "Datasource"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Fallos de autenticación (req/s)",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "sum(rate(auth_failures_total[5m]))", "legendFormat": "fallos/s", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Tokens inválidos (últimos 15m)",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 0 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 50 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "increase(invalid_tokens_total[15m])", "legendFormat": "tokens inválidos", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "IPs con más de 20 fallos (10m)",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 0 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "count(sum by(source_ip) (increase(auth_failures_total[10m])) > 20)",
          "legendFormat": "IPs sospechosas",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Fallos de autenticación en el tiempo",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        { "expr": "sum(rate(auth_failures_total[5m]))", "legendFormat": "fallos/s", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Tokens inválidos en el tiempo",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        { "expr": "increase(invalid_tokens_total[15m])", "legendFormat": "tokens inválidos / 15m", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Top IPs por fallos de autenticación (10m)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "topk(10, sum by(source_ip) (increase(auth_failures_total[10m])))",
          "legendFormat": "{{source_ip}}",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ]
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Alertas de seguridad",
        "datasource": "${DS_PROMETHEUS}",
        "enable": true,
        "expr": "ALERTS{team=\"security\"}",
        "iconColor": "red"
      }
    ]
  }
}
