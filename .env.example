POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=inventory_db
FLASK_APP=app.main

DATABASE_URL=postgresql://postgres:your_password_here@db:5432/inventory_db

# OpenTelemetry (on by default with docker compose up; set false to disable)
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318/v1/traces
OTEL_SERVICE_NAME=manage-system

# Keycloak Configuration
# Browser redirects use localhost; docker-compose.yml overrides server-side URLs
# (token/JWKS/userinfo) to http://keycloak_auth:8080 for container networking.
KEYCLOAK_REALM_URL=http://localhost:8080/realms/inventory-realm
# Realm admin (master) credentials used by /users admin UI via Keycloak Admin API
KEYCLOAK_USER=admin_username_here
KEYCLOAK_PASSWORD=admin_password_here
KEYCLOAK_TOKEN_CLIENT_ID=flask-backend
KEYCLOAK_ADMIN_API_URL=http://keycloak_auth:8080/admin
KEYCLOAK_ADMIN_TOKEN_URL=http://keycloak_auth:8080/realms/master/protocol/openid-connect/token

# Grafana admin login (Grafana requires real credentials now — no anonymous access,
# since it can be exposed publicly via the Cloudflare tunnel)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_admin_password_here