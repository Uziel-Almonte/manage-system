pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 45, unit: 'MINUTES')
    }

    environment {
        IMAGE_NAME = 'manage-system'
        IMAGE_TAG = "${env.BUILD_NUMBER ?: 'local'}"
        COMPOSE_PROJECT_NAME = "manage-system-ci-${env.BUILD_NUMBER ?: 'local'}"
        APP_SERVICE = 'web'
        REGISTRY = "${env.DOCKER_REGISTRY ?: ''}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build image') {
            steps {
                sh 'docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .'
            }
        }

        stage('Levantar entorno de pruebas') {
            steps {
                sh '''
                    docker compose -f docker-compose.yml -p ${COMPOSE_PROJECT_NAME} up -d --build db keycloak web
                    python - <<'PY'
import os
import time
import urllib.request

checks = [
    ("app", "http://localhost:5000/auth/login-page"),
    ("keycloak", "http://localhost:8080/realms/inventory-realm/.well-known/openid-configuration"),
]

for name, url in checks:
    ok = False
    for _ in range(60):
        try:
            with urllib.request.urlopen(url, timeout=3) as response:
                if response.status < 500:
                    ok = True
                    break
        except Exception:
            time.sleep(2)
    if not ok:
        raise SystemExit(f"{name} no quedó listo a tiempo")
PY
                '''
            }
        }

        stage('Instalar dependencias') {
            steps {
                sh '''
                    docker compose -p ${COMPOSE_PROJECT_NAME} exec -T ${APP_SERVICE} \
                        python -m pip install --no-cache-dir -r requirements.txt
                '''
            }
        }

        stage('Lint') {
            steps {
                sh '''
                    docker compose -p ${COMPOSE_PROJECT_NAME} exec -T ${APP_SERVICE} \
                        python -m pip install --no-cache-dir flake8
                    docker compose -p ${COMPOSE_PROJECT_NAME} exec -T ${APP_SERVICE} \
                        flake8 app/
                '''
            }
        }

        stage('Unit tests') {
            steps {
                sh '''
                    docker compose -p ${COMPOSE_PROJECT_NAME} exec -T ${APP_SERVICE} \
                        pytest tests/ --ignore=tests/e2e --ignore=tests/k6 \
                        --junitxml=report.xml --cov=app --cov-report=xml
                '''
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'report.xml'
                }
            }
        }

        stage('E2E tests') {
            steps {
                sh '''
                    docker compose -p ${COMPOSE_PROJECT_NAME} --profile e2e run --rm e2e
                '''
            }
        }

        stage('Load tests') {
            when {
                branch 'main'
            }
            steps {
                sh '''
                    docker run --rm -i \
                        --network=${COMPOSE_PROJECT_NAME}_default \
                        grafana/k6:0.53.0 run - < tests/k6/load-test.js
                '''
            }
        }

        stage('Push image') {
            when {
                allOf {
                    branch 'main'
                    expression { return env.REGISTRY?.trim() }
                }
            }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'docker-registry-creds',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh 'echo "$DOCKER_PASS" | docker login ${REGISTRY} -u "$DOCKER_USER" --password-stdin'
                    sh 'docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}'
                    sh 'docker push ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}'
                }
            }
        }
    }

    post {
        always {
            sh 'docker compose -p ${COMPOSE_PROJECT_NAME} down -v || true'
            cleanWs()
        }
    }
}